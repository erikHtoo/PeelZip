+
+Z7_CLASS_IMP_COM_1(CPeelInStream, ISequentialInStream)
+  CMyComPtr<ISequentialInStream> _stream;
+  UInt64 _pos, _remaining, _pending;
+public:
+  void Init(ISequentialInStream *stream, UInt64 pos, UInt64 length)
+  { _stream = stream; _pos = pos; _remaining = length; _pending = 0; }
+};
+
+Z7_COM7F_IMF(CPeelInStream::Read(void *data, UInt32 size, UInt32 *processedSize))
+{
+  UInt32 done = 0;
+  HRESULT res = _stream->Read(data, size, &done);
+  if (processedSize) *processedSize = done;
+  if (done > _remaining) return E_FAIL;
+  _pos += done;
+  _remaining -= done;
+  _pending += done;
+  if (_pending >= (1 << 20) || _remaining == 0)
+  {
+    RINOK(PeelConsumed("7z", 0, _pos - _pending, _pending))
+    _pending = 0;
+  }
+  return res;
+}
 
